# --- Base de datos (Railway te da esta URL automáticamente) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chacho?schema=public"

# --- Servidor ---
PORT=4000
NODE_ENV=development

# Origen permitido para CORS (frontend en dev). Coma-separado si hay varios.
CLIENT_ORIGIN="http://localhost:5173"

# --- Auth ---
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# --- Stripe (modo test para empezar) ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# URL pública del frontend (para redirecciones de Stripe Checkout)
PUBLIC_SITE_URL="http://localhost:5173"

# --- Email del formulario de contacto (OPCIONAL) ---
# Si no configuras SMTP, los mensajes solo se guardan en la BD (visibles en el panel admin).
# Con estos datos, además se envían por email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
CONTACT_TO="hola@chachopetshop.com"
CONTACT_FROM=""
