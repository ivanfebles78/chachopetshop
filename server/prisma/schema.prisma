// Chacho Pet Shop — esquema de datos (PostgreSQL vía Prisma)
// Modelo facetado: un producto se cruza con Animal (para quién),
// Category (qué tipo) y Need (necesidad de salud), más Brand y variantes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum CategoryType {
  DRY_FOOD
  WET_FOOD
  SEMIMOIST
  SNACKS
  SUPPLEMENTS
  HYGIENE
  ACCESSORIES
  BEDS
  TRAVEL
  VET_DIET
}

/**
 * Estados de un pedido.
 *
 * PENDING es «creado, esperando el pago»; PAID sólo lo escribe un webhook de
 * Stripe con firma válida y pago confirmado. FAILED y CANCELLED se separan
 * porque significan cosas distintas para el stock y para el cliente: un pago
 * rechazado puede reintentarse, uno cancelado lo abandonó la persona.
 */
enum OrderStatus {
  PENDING
  PAID
  FAILED
  FULFILLED
  CANCELLED
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  featured  Boolean   @default(false)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Animal {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  emoji    String?
  sortOrder Int      @default(0)
  products Product[]  @relation("ProductAnimals")
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      CategoryType
  sortOrder Int          @default(0)
  products  Product[]    @relation("ProductCategories")
}

model Need {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]  @relation("ProductNeeds")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  brand       Brand            @relation(fields: [brandId], references: [id])
  brandId     String
  price       Decimal          @db.Decimal(10, 2)
  compareAt   Decimal?         @db.Decimal(10, 2)
  image       String
  gallery     String[]
  /*
   * Reservados para un sistema de reseñas REAL. Hasta que exista, quedan
   * vacíos y no se publican: `@default(4.6)` convertía en «4,6 estrellas» a
   * cualquier producto recién creado, sin que nadie hubiese opinado.
   */
  rating      Float?
  reviews     Int?
  featured    Boolean          @default(false)
  bestseller  Boolean          @default(false)
  active      Boolean          @default(true)
  animals     Animal[]         @relation("ProductAnimals")
  categories  Category[]       @relation("ProductCategories")
  needs       Need[]           @relation("ProductNeeds")
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())

  @@index([brandId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  label     String // p.ej. "3 kg", "12 kg", "Pack 6x400g"
  price     Decimal @db.Decimal(10, 2)
  sku       String  @unique
  stock     Int     @default(0)

  @@index([productId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(CUSTOMER)
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  user            User?       @relation(fields: [userId], references: [id])
  userId          String?
  email           String
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  shipping        Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)
  stripeSessionId String?     @unique

  /*
   * Secreto de acceso al pedido, para que quien compra sin cuenta pueda ver su
   * confirmación. NO es el identificador: el id va en la URL y acaba en el
   * historial y en la cabecera Referer; esto son 32 bytes aleatorios que sólo
   * conoce quien completó la compra.
   */
  /*
   * Nullable a propósito. Los pedidos que ya existen en producción no tienen
   * token, y añadir una columna NOT NULL UNIQUE a una tabla con filas falla al
   * desplegar. Un pedido sin token simplemente no se puede consultar con token:
   * se consulta autenticado, que es lo que ya hacía antes de esta fase.
   */
  accessToken     String?     @unique

  /*
   * Si las existencias de este pedido siguen retenidas. El stock se descuenta al
   * crear la sesión de pago para que dos personas no puedan comprar la misma
   * última unidad, y se devuelve si el pago falla, se cancela o caduca. El
   * booleano hace que devolverlo sea idempotente: un webhook repetido no puede
   * reponer el stock dos veces.
   */
  stockCommitted  Boolean     @default(false)

  shippingName    String?
  shippingAddress String?
  shippingCity    String?
  shippingZip     String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())

  @@index([userId])
}

model OrderItem {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  productId    String
  variantId    String?
  name         String
  variantLabel String?
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  image        String?

  @@index([orderId])
}

/**
 * Eventos de Stripe ya procesados.
 *
 * Stripe reintenta los webhooks por diseño, así que llegan duplicados de forma
 * rutinaria. Sin este registro, un reintento volvería a aplicar los efectos:
 * reponer stock, cambiar estados, disparar correos. La clave única sobre el id
 * del evento es lo que convierte «procesar» en una operación idempotente.
 */
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
